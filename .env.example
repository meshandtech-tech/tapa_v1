# Transporte de rede da party (Supabase Realtime).
#
# SEM estas variáveis o app continua funcionando, mas só entre abas do MESMO
# navegador (BroadcastChannel). Com elas, celulares e PCs diferentes entram na
# mesma sala.
#
# Onde achar: painel do Supabase > Project Settings > Data API
#   VITE_SUPABASE_URL      = "Project URL"
#   VITE_SUPABASE_ANON_KEY = a chave "anon" / "publishable"
#
# Ambas são públicas por natureza (vão para o browser de qualquer jeito).
# Não use aqui a chave "service_role" — essa é secreta e não tem uso no Tapa.
#
# Copie este arquivo para .env e preencha:  cp .env.example .env
# Em produção, cadastre as duas em Vercel > Settings > Environment Variables.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
